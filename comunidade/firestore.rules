rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() { return request.auth != null; }
    function admin() { return logado() && request.auth.uid in ['COLE_AQUI_O_SEU_UID']; }
    function so(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    match /comentarios/{id} {
      allow read: if true;
      allow create: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
        && request.resource.data.pagina is string && request.resource.data.pagina.size() < 300
        && request.resource.data.removido == false && request.resource.data.criado == request.time;
      allow update: if (logado() && resource.data.uid == request.auth.uid || admin()) && so(['removido']) && request.resource.data.removido == true;
      allow delete: if admin();
    }
    match /topicos/{id} {
      allow read: if true;
      allow create: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 140
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 5000
        && request.resource.data.score == 0 && request.resource.data.nresp == 0 && request.resource.data.removido == false;
      allow update: if logado() && (
          (so(['score']) && request.resource.data.score - resource.data.score <= 2 && resource.data.score - request.resource.data.score <= 2)
        || (so(['nresp', 'ativo']) && request.resource.data.nresp == resource.data.nresp + 1)
        || ((resource.data.uid == request.auth.uid || admin()) && so(['removido']) && request.resource.data.removido == true));
      allow delete: if admin();
      match /votos/{uid} {
        allow read: if true;
        allow write: if logado() && uid == request.auth.uid && request.resource.data.v in [-1, 0, 1];
      }
    }
    match /denuncias/{id} {
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if admin();
    }
  }
}
